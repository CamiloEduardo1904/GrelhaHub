# GrelhaHub — convenções de formatação
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

# Diretiva using fora do namespace, ordenada, System primeiro.
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

# Torna a intenção explícita no código que expressa regra de negócio.
dotnet_style_readonly_field = true:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion

[*.{csproj,props,targets,config,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
end_of_line = lf

[*.{cmd,bat,ps1}]
end_of_line = crlf

# Migrations são geradas pelo `dotnet ef` — não seguem o estilo do projeto e não devem ser
# editadas a mão. Analisar código gerado só produz ruído que esconde problema real.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
