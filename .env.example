# GrelhaHub — template de variáveis de ambiente
#
# Copie para `.env` NA VPS e preencha com os valores reais.
# O arquivo `.env` NUNCA é versionado (RNF-008) — está no .gitignore.
# No Azure DevOps, os mesmos valores vivem em Variable Group.

# ---------- Domínio ----------
# Pendência aberta (restrição R5): domínio ainda não adquirido.
# Plano B validado para testes: DuckDNS.
# ---------- Domínio ----------
# O Traefik da VPS roteia por este nome e emite o certificado sozinho.
DOMINIO=grelhahub.com

# ---------- Portas (só no modo docker-compose.exposto.yml) ----------
# Ignoradas quando o Traefik é a borda, que é o caso desta VPS.
PORTA_HTTP=8080
PORTA_HTTPS=8443


# ---------- Registry ----------
DOCKER_REGISTRY=docker.io/seu-usuario
IMAGE_TAG=latest

# ---------- JWT emissor/audiência ----------
JWT_EMISSOR=grelhahub-api
JWT_AUDIENCIA=grelhahub-web

# ---------- PostgreSQL ----------
# RNF-007: o banco não é exposto publicamente. Esta senha só trafega na rede interna
# do Docker, mas ainda assim deve ser longa e gerada aleatoriamente.
POSTGRES_DB=grelhahub

# ADR-0017 — o banco de LOG (trilha de auditoria + exceções) chama-se <POSTGRES_DB>_log e vive na
# MESMA instância. Ele NÃO é criado pelo contêiner do PostgreSQL, que só cria POSTGRES_DB.
#
# O banco é criado pelo step de migrations do pipeline — o MigrateAsync do EF Core cria o banco
# quando ele não existe. Não há passo manual.
#
# Sem ele a API NÃO SOBE, e isso é deliberado: sistema sem onde gravar a trilha não deveria
# aceitar a primeira requisição — a operação gravaria e o registro não (RN-GER-015).
POSTGRES_USER=grelhahub
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# ---------- JWT (ADR-0003) ----------
# Mínimo de 32 bytes. Gere com: openssl rand -base64 48
JWT_CHAVE=troque-por-uma-chave-aleatoria-de-no-minimo-32-bytes
JWT_EMISSOR=grelhahub-api
JWT_AUDIENCIA=grelhahub-web

# ─── Usuário de suporte da plataforma — RN-GER-014, ADR-0013 ────────────────────
#
# ⚠⚠ Este usuário enxerga TODAS as unidades: o filtro por restaurante é desligado
# para ele. Trate a senha como a mais sensível da instalação.
#
# ⚠ Os nomes aqui são de shell; o mapeamento para a configuração da API
# (`Plataforma__*`) está no `environment:` do serviço `api` em docker-compose.yml,
# igual ao JWT_CHAVE. Sem esse mapeamento, preencher aqui não tem efeito nenhum.
#
# Criado pelo step "Semear plataforma" do deploy — `docker compose run --rm api dotnet
# GrelhaHub.Api.dll --semear` —, NÃO por `up -d` nem por `--migrate`. Idempotente:
# não sobrescreve a senha de quem já existe. Deixe em branco para não ter suporte
# (o log do deploy registra o aviso RN-GER-014 e a instalação segue sem suporte).
#
# ⚠ O e-mail NÃO pode ser o de um usuário de restaurante: o e-mail é único
# globalmente, e o semeador falha com exit 1, abortando o deploy.
#
# Senha: gere na VPS, nunca aqui — openssl rand -base64 24
PLATAFORMA_NOME=Suporte GrelhaHub
PLATAFORMA_EMAIL=
PLATAFORMA_SENHA_INICIAL=

# ─── Correio — RN-GER-032, ADR-0016 ────────────────────────────────────────────
#
# ⚠ AQUI VAI SÓ A SENHA. Host, porta, usuário, remetente e base do site vivem no
# `appsettings.json`, versionados — não são segredo, e ter o mesmo valor em dois
# lugares é como se perde a configuração: uma variável vazia no .env sobrescreve o
# appsettings com string vazia, e o valor certo fica escrito sem valer.
#
# É a senha DA CAIXA sistema@grelhahub.com, não a do hPanel.
#
# Em branco = nada é enviado. Estado válido (RN-GER-032): o log registra cada e-mail
# que deixou de sair e nenhuma operação falha por isso.
EMAIL_SENHA=
