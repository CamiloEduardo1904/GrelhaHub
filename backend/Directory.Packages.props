<Project>

  <!--
    Central Package Management — a versão de cada pacote é declarada UMA vez, aqui.
    Os .csproj referenciam sem Version. Evita divergência de versão entre projetos,
    que é a causa mais comum de erro de build que só aparece em um projeto.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="CQRS e validação — ADR-0002">
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>

  <ItemGroup Label="Persistência — PostgreSQL, ADR-0004">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

    <!-- ADR-0016 — SMTP. `System.Net.Mail.SmtpClient` é desaconselhado pela Microsoft para
         código novo, e o MailKit é o substituto que a própria documentação indica. -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup Label="Identidade e acesso — ADR-0022">
    <!--
      ADR-0022 §1 — a ÚNICA dependência que o Domínio pode referenciar: POCOs (IdentityUser,
      IdentityRole) e abstrações de store. Não traz EF Core, não traz ASP.NET runtime.
      O antigo Microsoft.AspNetCore.Identity 2.3.1 (pacote do ASP.NET clássico) saiu daqui:
      o PasswordHasher que a Infrastructure usava vem transitivamente destes dois.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />

    <!--
      Pacote de ABSTRAÇÕES de autorização (existe no NuGet, fora do shared framework): é o que
      permite ao PermissaoBehavior chamar IAuthorizationService sem a Application referenciar o
      runtime do ASP.NET. As políticas em si são registradas na partida da Api (uma por permissão
      do CatalogoDeAcesso).
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Observabilidade — RNF-019">
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup Label="Testes de integração — PostgreSQL real, exigido por ADR-0009">
    <!--
      O provider in-memory do EF Core NÃO executa CHECK, EXCLUDE, trigger nem coluna
      gerada. Como boa parte das regras vive exatamente nesses mecanismos (ADR-0009),
      testar contra in-memory daria falsa confiança justamente onde mais importa.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Pins de segurança — dependências transitivas com CVE conhecido">
    <!--
      Com CentralPackageTransitivePinningEnabled, declarar a versão aqui força a resolução
      da dependência transitiva, sem precisar referenciá-la nos projetos.

      Ao atualizar pacotes, confira as vulnerabilidades transitivas com
      `dotnet list package` usando as opções de vulnerabilidade e transitivas.
      (o enunciado evita hifens duplos: XML não admite dois hifens seguidos em comentário)

      Microsoft.OpenApi fica na linha 2.x: a 3.x quebra o source generator do
      Microsoft.AspNetCore.OpenApi 10, em que IOpenApiMediaType.Example passou a ser
      somente leitura.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
