<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!--
      EF Core aqui é apenas para IApplicationDbContext (DbSet<T>) e projeção de queries.
      Nenhuma referência a Npgsql: o provider é detalhe da Infrastructure.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!--
      ADR-0022 §3 — a verificação de permissão passa a ser POLÍTICA do ASP.NET, e o
      PermissaoBehavior a executa via IAuthorizationService. Este pacote traz só as
      abstrações (vive no NuGet, fora do shared framework); quem registra as políticas —
      uma por permissão do CatalogoDeAcesso — é a Api, na partida.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrelhaHub.Domain\GrelhaHub.Domain.csproj" />
  </ItemGroup>

</Project>
