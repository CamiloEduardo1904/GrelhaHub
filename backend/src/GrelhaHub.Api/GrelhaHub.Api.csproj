<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Nome do assembly usado no Dockerfile e no docker-compose. -->
    <AssemblyName>GrelhaHub.Api</AssemblyName>
    <UserSecretsId>grelhahub-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- ADR-0003: autenticação stateless por JWT. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- RNF-019: log estruturado com identificador de correlação. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrelhaHub.Application\GrelhaHub.Application.csproj" />
    <ProjectReference Include="..\GrelhaHub.Infrastructure\GrelhaHub.Infrastructure.csproj" />
  </ItemGroup>

</Project>
