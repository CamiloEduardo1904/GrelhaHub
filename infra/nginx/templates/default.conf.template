# Nginx da borda — ADR-0006.
#
# Este arquivo é um TEMPLATE: a imagem nginx:alpine roda envsubst sobre tudo em
# /etc/nginx/templates/*.template na partida e escreve em /etc/nginx/conf.d/.
# Só as variáveis listadas em `command:` no compose são substituídas — as do
# próprio nginx ($host, $uri) precisam ficar de fora, senão viram string vazia.
#
# Este bloco serve HTTP e funciona sem certificado. O HTTPS entra pelo include
# de /etc/nginx/tls-ativo/, que começa vazio e ganha conteúdo quando você roda
# infra/ativar-https.sh. É o que resolve o ovo-e-galinha do Let's Encrypt:
# o certbot precisa do nginx no ar para responder o desafio, e o nginx não sobe
# apontando para um certificado que ainda não existe.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    server_tokens off;
    client_max_body_size 10M;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Desafio do Let's Encrypt. Precisa continuar acessível em HTTP mesmo depois
    # do TLS ativo, senão a renovação automática falha.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/tls-ativo/redirecionar.conf*;

    location /api/ {
        proxy_pass         http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # RNF-003 — relatório de 12 meses pode levar até 5 s.
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass         http://web:80;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
    }
}

# Servidor HTTPS — só existe depois de infra/ativar-https.sh.
include /etc/nginx/tls-ativo/servidor.conf*;
